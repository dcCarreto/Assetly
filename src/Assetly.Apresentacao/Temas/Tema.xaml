<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:visao="clr-namespace:Assetly.Apresentacao.Visao">

    <visao:MaiusculaConverter x:Key="MaiusculaConverter"/>

    <!-- ============================================================
         Texto base e camadas de tipografia
         ============================================================ -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextBody}"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontUi}"/>
        <Setter Property="FontSize" Value="12.5"/>
    </Style>

    <Style x:Key="TituloPaginaStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontUi}"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTitle}"/>
    </Style>

    <Style x:Key="LegendaStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontUi}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
    </Style>

    <Style x:Key="NomeAppTextoJanelaStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontUi}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTitle}"/>
    </Style>

    <!-- Texto de conteúdo já deve chegar em maiúsculas (ver MaiusculaConverter / .ToUpperInvariant()
         nos pontos de uso) — TextBlock não expõe CharacterCasing como TextBox expõe. -->
    <Style x:Key="RotuloKpiStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontMono}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextLabel}"/>
    </Style>

    <Style x:Key="ValorKpiStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontUi}"/>
        <Setter Property="FontSize" Value="27"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTitle}"/>
        <Setter Property="Margin" Value="0,5,0,3"/>
    </Style>

    <Style x:Key="DeltaKpiStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontUi}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <Style x:Key="RotuloFormularioStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontUi}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextLabel}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Célula de dados mono (datas, IDs, valores monetários) — sempre alinhada à direita.
         Valor ausente ("—", ver Formatador) usa TextMuted em vez da cor normal da célula. -->
    <Style x:Key="CelulaMonoStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontMono}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="—">
                <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Célula de destaque (ex.: nome do bem) — mesma tipografia base, só o peso muda. -->
    <Style x:Key="CelulaDestaqueStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontUi}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBody}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Célula secundária (observações, mensagens, suporte) — mesmo texto ausente vira "—" muted. -->
    <Style x:Key="CelulaSecundariaStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontUi}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="—">
                <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================================
         Barra de título (janela e diálogos)
         ============================================================ -->
    <Style x:Key="TituloJanelaTextoStyle" TargetType="TextBlock" BasedOn="{StaticResource NomeAppTextoJanelaStyle}"/>

    <Style x:Key="BotaoJanelaStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TitleBarGlyph}"/>
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="fundo" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="fundo" Property="Background" Value="{DynamicResource TitleBarButtonHoverBg}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BotaoJanelaFecharStyle" TargetType="Button" BasedOn="{StaticResource BotaoJanelaStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="fundo" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="fundo" Property="Background" Value="{DynamicResource TitleBarCloseHoverBg}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TitleBarCloseHoverGlyph}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         Botões de ação
         ============================================================ -->
    <Style x:Key="BotaoBaseStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource FontUi}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="fundo" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.52"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BotaoPrimarioStyle" TargetType="Button" BasedOn="{StaticResource BotaoBaseStyle}">
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonGradient}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
        <Setter Property="Foreground" Value="{DynamicResource ButtonPrimaryText}"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="14,0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource PrimaryButtonHoverGradient}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource PrimaryButtonPressedGradient}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource ButtonDisabledBg}"/>
                <Setter Property="Foreground" Value="{DynamicResource ButtonDisabledText}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ButtonDisabledBg}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BotaoSecundarioStyle" TargetType="Button" BasedOn="{StaticResource BotaoBaseStyle}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorder}"/>
        <Setter Property="Foreground" Value="{DynamicResource ButtonSecondaryText}"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="12,0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource BgSurface1}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BotaoPerigoStyle" TargetType="Button" BasedOn="{StaticResource BotaoBaseStyle}">
        <Setter Property="Background" Value="{DynamicResource ButtonDangerBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonDangerBorder}"/>
        <Setter Property="Foreground" Value="{DynamicResource ButtonDangerText}"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="12,0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ButtonDangerHoverBg}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================================
         Chip de filtro (barra de filtros das telas de tabela)
         ============================================================ -->
    <!-- Aba interna de módulo (ex.: Automóveis: Veículos | Abastecimentos | Despesas). -->
    <Style x:Key="AbaStyle" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{DynamicResource FontUi}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="4,8"/>
        <Setter Property="Margin" Value="0,0,22,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="sublinhado" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextTitle}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextTitle}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter TargetName="sublinhado" Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ChipFilterStyle" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{DynamicResource FontUi}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Height" Value="27"/>
        <Setter Property="Padding" Value="11,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="fundo" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="fundo" Property="Background" Value="{DynamicResource BgSurface1}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="fundo" Property="Background" Value="{DynamicResource BgSurface1}"/>
                            <Setter TargetName="fundo" Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextTitle}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botão "X" que limpa a seleção na barra contextual de ações. -->
    <Style x:Key="BotaoLimparSelecaoStyle" TargetType="Button">
        <Setter Property="Width" Value="19"/>
        <Setter Property="Height" Value="19"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="fundo" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="5">
                        <TextBlock Text="&#x2715;" FontSize="8" Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="fundo" Property="Background" Value="{DynamicResource BgSurface1}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         Painéis (dashboard e contêiner de tabela)
         ============================================================ -->
    <Style x:Key="CardPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style x:Key="PanelHeaderStyle" TargetType="Border">
        <Setter Property="Height" Value="42"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="14,0"/>
    </Style>

    <Style x:Key="PanelTituloStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontUi}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTitle}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="PanelContadorStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BgSurface2}"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Padding" Value="7,1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="PanelContadorTextoStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontMono}"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    </Style>

    <Style x:Key="PanelLinkStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontUi}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- Célula da faixa de 6 indicadores — borda esquerda separa as células (exceto a primeira, em código). -->
    <Style x:Key="KpiStripCellStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
        <Setter Property="BorderThickness" Value="1,0,0,0"/>
        <Setter Property="Padding" Value="18,0"/>
    </Style>

    <!-- ============================================================
         Menu lateral
         ============================================================ -->
    <Style x:Key="SidebarItemStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="2,0,0,0"/>
        <Setter Property="Padding" Value="15,0,14,0"/>
        <Setter Property="Height" Value="46"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="fundo" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="fundo" Property="Background" Value="{DynamicResource BgSurface1}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="fundo" Property="Background" Value="{DynamicResource BgSurface2}"/>
                            <Setter TargetName="fundo" Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ItemMenuLateralTextoStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontUi}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    </Style>

    <!-- ============================================================
         Campos de entrada
         ============================================================ -->
    <Style x:Key="CampoTextoStyle" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource FontUi}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Background" Value="{DynamicResource InputBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBody}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextBody}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource BgSurface2}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="fundo" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                        <Grid>
                            <!-- Texto de dica (Tag) visível enquanto o campo está vazio. -->
                            <TextBlock x:Name="dica" Text="{TemplateBinding Tag}" Foreground="{DynamicResource TextMuted}"
                                       Margin="{TemplateBinding Padding}" Padding="2,0,0,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Text" Value=""/>
                                <Condition Property="IsKeyboardFocused" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="dica" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="fundo" Property="BorderBrush" Value="{DynamicResource InputFocusBorder}"/>
                            <Setter TargetName="fundo" Property="Effect" Value="{DynamicResource FocusHalo}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AreaTextoStyle" TargetType="TextBox" BasedOn="{StaticResource CampoTextoStyle}">
        <Setter Property="MinHeight" Value="64"/>
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
    </Style>

    <!-- Campos de diálogo: mesma aparência, 32px de altura (formulários em grade têm mais respiro). -->
    <Style x:Key="CampoTextoDialogoStyle" TargetType="TextBox" BasedOn="{StaticResource CampoTextoStyle}">
        <Setter Property="MinHeight" Value="32"/>
    </Style>

    <!-- Campo de senha (backup criptografado): mesma aparência dos campos de texto. -->
    <Style x:Key="CampoSenhaStyle" TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="{DynamicResource FontUi}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Background" Value="{DynamicResource InputBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBody}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextBody}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource BgSurface2}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="fundo" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="fundo" Property="BorderBrush" Value="{DynamicResource InputFocusBorder}"/>
                            <Setter TargetName="fundo" Property="Effect" Value="{DynamicResource FocusHalo}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CheckBoxStyle" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{DynamicResource FontUi}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBody}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="caixa" Width="16" Height="16" CornerRadius="4" VerticalAlignment="Center"
                                Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1">
                            <Path x:Name="marca" Data="M2,6 L6,10 L12,2" Stroke="{DynamicResource ButtonPrimaryText}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="caixa" Property="Background" Value="{DynamicResource AccentPrimary}"/>
                            <Setter TargetName="caixa" Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
                            <Setter TargetName="marca" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="caixa" Property="BorderBrush" Value="{DynamicResource InputFocusBorder}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="{DynamicResource CardBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBody}"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontUi}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Padding" Value="8,6"/>
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{DynamicResource BgSurface2}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextTitle}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ComboStyle" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{DynamicResource FontUi}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Background" Value="{DynamicResource InputBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBody}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="22"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="1" Data="M0,0 L4,4 L8,0 Z" Fill="{DynamicResource TextSecondary}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <ToggleButton.Background>
                                <Binding Path="Background" RelativeSource="{RelativeSource TemplatedParent}"/>
                            </ToggleButton.Background>
                            <ToggleButton.BorderBrush>
                                <Binding Path="BorderBrush" RelativeSource="{RelativeSource TemplatedParent}"/>
                            </ToggleButton.BorderBrush>
                        </ToggleButton>
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                            <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource InputBorder}"
                                    BorderThickness="1" CornerRadius="7" MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="240">
                                <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                    <StackPanel IsItemsHost="True"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DatePickerStyle" TargetType="DatePicker">
        <Setter Property="FontFamily" Value="{DynamicResource FontUi}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Background" Value="{DynamicResource InputBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBody}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <!-- Template próprio: o padrão do Windows tem caixa de texto branca e dica "Select a
                     date" em inglês. As partes PART_* são exigidas pelo DatePicker. -->
                <ControlTemplate TargetType="DatePicker">
                    <Border x:Name="fundo" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                        <Grid x:Name="PART_Root">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0" Margin="{TemplateBinding Padding}"
                                               Foreground="{TemplateBinding Foreground}" VerticalContentAlignment="Center"/>
                            <Button x:Name="PART_Button" Grid.Column="1" Focusable="False" Cursor="Hand" Width="30"
                                    ToolTip="Abrir calendário" Foreground="{DynamicResource TextSecondary}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="area" Background="Transparent" CornerRadius="0,6,6,0">
                                            <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       Foreground="{TemplateBinding Foreground}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="area" Property="Background" Value="{DynamicResource BgSurface1}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding ElementName=fundo}" StaysOpen="False"
                                   AllowsTransparency="True"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="fundo" Property="BorderBrush" Value="{DynamicResource InputFocusBorder}"/>
                            <Setter TargetName="fundo" Property="Effect" Value="{DynamicResource FocusHalo}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DatePickerTextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextBody}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource BgSurface2}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePickerTextBox">
                    <Grid Background="Transparent">
                        <TextBlock x:Name="dica" Text="dd/mm/aaaa" Foreground="{DynamicResource TextMuted}" Padding="2,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="dica" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ComboDialogoStyle" TargetType="ComboBox" BasedOn="{StaticResource ComboStyle}">
        <Setter Property="MinHeight" Value="32"/>
    </Style>

    <Style x:Key="DatePickerDialogoStyle" TargetType="DatePicker" BasedOn="{StaticResource DatePickerStyle}">
        <Setter Property="MinHeight" Value="32"/>
    </Style>

    <!-- ============================================================
         Badge / etiqueta (status e severidade) — retangular, mesmo raio dos botões
         (a especificação original pedia raio 999, mas o pill oval não combina com o
         restante da interface — mantido retangular por pedido explícito do usuário)
         ============================================================ -->
    <Style x:Key="BadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource StatusNeutroBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource StatusNeutroBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Padding" Value="9,2"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <Style x:Key="BadgeTextoStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontUi}"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- ============================================================
         Cards
         ============================================================ -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="14"/>
    </Style>

    <!-- Card de indicador (KPI): rótulo -> valor -> delta -->
    <Style x:Key="CardKpiStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Padding" Value="14,13"/>
    </Style>

    <!-- ============================================================
         ContextMenu
         ============================================================ -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource CardBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6"/>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBody}"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontUi}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="fundo" Background="{TemplateBinding Background}" CornerRadius="6">
                        <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="fundo" Property="Background" Value="{DynamicResource BgSurface2}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource CardBorder}"/>
        <Setter Property="Margin" Value="4,4"/>
    </Style>

    <!-- ============================================================
         ScrollBar
         ============================================================ -->
    <Style x:Key="AssetlyScrollBarThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{DynamicResource InputBorder}" CornerRadius="999"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="{DynamicResource BgBase}"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource AssetlyScrollBarThumb}" Width="8"/>
                            </Track.Thumb>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Background="Transparent"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Background="Transparent"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Barra horizontal (tabelas em janelas estreitas): sem isto ela herdava a largura fixa de
                 10px da vertical e aparecia como um "polegar" solto no rodapé da tabela. -->
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource AssetlyScrollBarThumb}" Height="8"/>
                                    </Track.Thumb>
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Background="Transparent"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Background="Transparent"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================================
         DataGrid
         ============================================================ -->
    <Style x:Key="TabelaStyle" TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource CardBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBody}"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontUi}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="RowBackground" Value="{DynamicResource CardBg}"/>
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource CardBg}"/>
        <Setter Property="HorizontalGridLinesBrush" Value="Transparent"/>
        <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="CanUserReorderColumns" Value="False"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="RowHeight" Value="{DynamicResource TabelaAlturaLinha}"/>
        <Setter Property="GridLinesVisibility" Value="None"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <!-- A borda de status da linha (3px + 1px de seleção) deixava a linha alguns pixels mais larga
             que a área visível e forçava uma barra horizontal inútil; as colunas proporcionais já se ajustam. -->
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>

    <Style x:Key="CabecalhoColunaStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource BgSurface1}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                        <TextBlock Text="{TemplateBinding Content, Converter={StaticResource MaiusculaConverter}}"
                                   FontFamily="{DynamicResource FontMono}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextLabel}" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Linha: fundo e borda esquerda de 3px vêm do status (definidos em código por linha, via
         EtiquetaApoio — mesmo mapeamento usado pelo badge). A seleção soma um contorno externo de
         1px em accent, sem alterar o fundo, para nunca encobrir a cor de status. -->
    <Style x:Key="LinhaTabelaStyle" TargetType="DataGridRow">
        <Setter Property="Background" Value="{DynamicResource CardBg}"/>
        <Setter Property="BorderThickness" Value="3,0,0,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridRow">
                    <Border x:Name="selecaoBorda" BorderThickness="1" BorderBrush="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="statusBorda" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <Border BorderBrush="{DynamicResource RowDivider}" BorderThickness="0,0,0,1" SnapsToDevicePixels="True">
                                <SelectiveScrollingGrid>
                                    <SelectiveScrollingGrid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                    </SelectiveScrollingGrid.ColumnDefinitions>
                                    <DataGridCellsPresenter SelectiveScrollingGrid.SelectiveScrollingOrientation="Vertical"/>
                                </SelectiveScrollingGrid>
                            </Border>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="statusBorda" Property="Background" Value="{DynamicResource RowHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="selecaoBorda" Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CelulaTabelaStyle" TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="{DynamicResource TabelaPaddingCelula}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBody}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextTitle}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ListaArquivosStyle" TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource CardBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Background" Value="{DynamicResource CardBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBody}"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontUi}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="fundo" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="fundo" Property="Background" Value="{DynamicResource BgSurface1}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="fundo" Property="Background" Value="{DynamicResource BgSurface2}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextTitle}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
