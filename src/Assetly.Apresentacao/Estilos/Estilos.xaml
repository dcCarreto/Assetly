<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="FonteBase">Segoe UI, Arial</FontFamily>

    <!-- Paleta base -->
    <SolidColorBrush x:Key="CorFundoBase" Color="#070B12"/>
    <SolidColorBrush x:Key="CorFundoControle" Color="#111827"/>
    <SolidColorBrush x:Key="CorAccent" Color="#38BDF8"/>
    <SolidColorBrush x:Key="CorJanelaEscuraFundo" Color="#050812"/>
    <SolidColorBrush x:Key="CorJanelaEscuraBorda" Color="#1E293B"/>

    <LinearGradientBrush x:Key="FundoRaizBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#101827" Offset="0"/>
        <GradientStop Color="#08111E" Offset="0.48"/>
        <GradientStop Color="#050812" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BarraTituloBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#080D15" Offset="0"/>
        <GradientStop Color="#0D1624" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CabecalhoAplicacaoBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0B111A" Offset="0"/>
        <GradientStop Color="#0E1726" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="MarcaSimboloBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#38BDF8" Offset="0"/>
        <GradientStop Color="#14B8A6" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="MenuLateralBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0A101A" Offset="0"/>
        <GradientStop Color="#080D15" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BotaoNavegacaoSelecionadoBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#12324A" Offset="0"/>
        <GradientStop Color="#111C2D" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ResumoOperacaoBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#101A2A" Offset="0"/>
        <GradientStop Color="#0D1522" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BotaoPrimarioBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#22D3EE" Offset="0"/>
        <GradientStop Color="#0891B2" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BotaoPrimarioHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#67E8F9" Offset="0"/>
        <GradientStop Color="#06B6D4" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LinhaSelecionadaBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0E7490" Offset="0"/>
        <GradientStop Color="#164E63" Offset="1"/>
    </LinearGradientBrush>

    <!-- Textos -->
    <SolidColorBrush x:Key="TextoTituloBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="TextoPadraoBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="TextoCelulaBrush" Color="#D8E2F0"/>
    <SolidColorBrush x:Key="TextoSuaveBrush" Color="#8EA3B7"/>
    <SolidColorBrush x:Key="TextoSuave2Brush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="TextoApagadoBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="TextoJanelaBrush" Color="#DBEAFE"/>

    <!-- Superfícies de card -->
    <SolidColorBrush x:Key="CardFundoBrush" Color="#0F1724"/>
    <SolidColorBrush x:Key="CardBordaBrush" Color="#223047"/>
    <SolidColorBrush x:Key="InputFundoBrush" Color="#0B1220"/>
    <SolidColorBrush x:Key="InputBordaBrush" Color="#2A3A53"/>

    <!-- Linhas de tabela por categoria -->
    <SolidColorBrush x:Key="LinhaOkBrush" Color="#0D1C1B"/>
    <SolidColorBrush x:Key="LinhaInformativaBrush" Color="#0C1C2A"/>
    <SolidColorBrush x:Key="LinhaAvisoBrush" Color="#211B0E"/>
    <SolidColorBrush x:Key="LinhaPerigoBrush" Color="#241317"/>
    <SolidColorBrush x:Key="LinhaNeutraBrush" Color="#121A27"/>
    <SolidColorBrush x:Key="LinhaImparBrush" Color="#111A29"/>
    <SolidColorBrush x:Key="LinhaHoverBrush" Color="#162238"/>

    <!-- Etiquetas semânticas -->
    <SolidColorBrush x:Key="EtiquetaOkFundo" Color="#052E2B"/>
    <SolidColorBrush x:Key="EtiquetaOkBorda" Color="#0F766E"/>
    <SolidColorBrush x:Key="EtiquetaOkTexto" Color="#99F6E4"/>
    <SolidColorBrush x:Key="EtiquetaInfoFundo" Color="#0C2D3B"/>
    <SolidColorBrush x:Key="EtiquetaInfoBorda" Color="#0E7490"/>
    <SolidColorBrush x:Key="EtiquetaInfoTexto" Color="#A5F3FC"/>
    <SolidColorBrush x:Key="EtiquetaAvisoFundo" Color="#2D2308"/>
    <SolidColorBrush x:Key="EtiquetaAvisoBorda" Color="#B45309"/>
    <SolidColorBrush x:Key="EtiquetaAvisoTexto" Color="#FDE68A"/>
    <SolidColorBrush x:Key="EtiquetaPerigoFundo" Color="#3B1118"/>
    <SolidColorBrush x:Key="EtiquetaPerigoBorda" Color="#B91C1C"/>
    <SolidColorBrush x:Key="EtiquetaPerigoTexto" Color="#FECDD3"/>
    <SolidColorBrush x:Key="EtiquetaArquivadoFundo" Color="#1F2937"/>
    <SolidColorBrush x:Key="EtiquetaArquivadoBorda" Color="#475569"/>
    <SolidColorBrush x:Key="EtiquetaArquivadoTexto" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="EtiquetaNeutraFundo" Color="#182233"/>
    <SolidColorBrush x:Key="EtiquetaNeutraBorda" Color="#334155"/>
    <SolidColorBrush x:Key="EtiquetaNeutraTexto" Color="#CBD5E1"/>

    <!-- Efeitos -->
    <DropShadowEffect x:Key="SombraCard" Color="Black" Opacity="0.22" BlurRadius="16" ShadowDepth="3" Direction="270"/>
    <DropShadowEffect x:Key="SombraCabecalho" Color="Black" Opacity="0.34" BlurRadius="20" ShadowDepth="4" Direction="270"/>
    <DropShadowEffect x:Key="BrilhoFoco" Color="#38BDF8" Opacity="0.5" BlurRadius="10" ShadowDepth="0"/>

    <!-- Texto padrão de qualquer elemento -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextoPadraoBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource FonteBase}"/>
    </Style>

    <Style x:Key="TituloAplicacaoStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="27"/>
        <Setter Property="FontWeight" Value="Black"/>
        <Setter Property="Foreground" Value="{StaticResource TextoTituloBrush}"/>
    </Style>

    <Style x:Key="SubtituloAplicacaoStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextoSuave2Brush}"/>
    </Style>

    <Style x:Key="TituloSecaoStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontWeight" Value="Black"/>
        <Setter Property="Foreground" Value="{StaticResource TextoTituloBrush}"/>
    </Style>

    <Style x:Key="TextoSuaveStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextoSuaveBrush}"/>
    </Style>

    <Style x:Key="RotuloFormularioStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Black"/>
        <Setter Property="Foreground" Value="#CBD5E1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Barra de título (janela e diálogos) -->
    <Style x:Key="TituloJanelaTextoStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextoJanelaBrush}"/>
    </Style>

    <Style x:Key="BotaoJanelaStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#CBD5E1"/>
        <Setter Property="Width" Value="42"/>
        <Setter Property="Height" Value="29"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="fundo" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="fundo" Property="Background" Value="#172033"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BotaoJanelaFecharStyle" TargetType="Button" BasedOn="{StaticResource BotaoJanelaStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="fundo" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="fundo" Property="Background" Value="#991B1B"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botões de ação -->
    <Style x:Key="BotaoBaseStyle" TargetType="Button">
        <Setter Property="FontWeight" Value="Black"/>
        <Setter Property="Padding" Value="13,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="fundo" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.52"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BotaoPrimarioStyle" TargetType="Button" BasedOn="{StaticResource BotaoBaseStyle}">
        <Setter Property="Background" Value="{StaticResource BotaoPrimarioBrush}"/>
        <Setter Property="BorderBrush" Value="#67E8F9"/>
        <Setter Property="Foreground" Value="#03131C"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BotaoPrimarioHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#0891B2"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BotaoSecundarioStyle" TargetType="Button" BasedOn="{StaticResource BotaoBaseStyle}">
        <Setter Property="Background" Value="#121C2C"/>
        <Setter Property="BorderBrush" Value="{StaticResource InputBordaBrush}"/>
        <Setter Property="Foreground" Value="#D7E3F2"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#18263A"/>
                <Setter Property="BorderBrush" Value="#3B5374"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource CardFundoBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BotaoPerigoStyle" TargetType="Button" BasedOn="{StaticResource BotaoBaseStyle}">
        <Setter Property="Background" Value="#2A1117"/>
        <Setter Property="BorderBrush" Value="#7F1D1D"/>
        <Setter Property="Foreground" Value="#FECDD3"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#3B151D"/>
                <Setter Property="BorderBrush" Value="#EF4444"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Navegação lateral -->
    <Style x:Key="BotaoNavegacaoStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="fundo" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8" MinHeight="58">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="fundo" Property="Background" Value="#111C2D"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="fundo" Property="Background" Value="{StaticResource BotaoNavegacaoSelecionadoBrush}"/>
                            <Setter TargetName="fundo" Property="BorderBrush" Value="#1E6C91"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Campos de entrada -->
    <Style x:Key="CampoTextoStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource InputFundoBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextoPadraoBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource InputBordaBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,7"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="CaretBrush" Value="{StaticResource TextoPadraoBrush}"/>
        <Setter Property="SelectionBrush" Value="#155E75"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="fundo" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="fundo" Property="BorderBrush" Value="{StaticResource CorAccent}"/>
                            <Setter TargetName="fundo" Property="Effect" Value="{StaticResource BrilhoFoco}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AreaTextoStyle" TargetType="TextBox" BasedOn="{StaticResource CampoTextoStyle}">
        <Setter Property="MinHeight" Value="70"/>
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="{StaticResource CardFundoBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextoCelulaBrush}"/>
        <Setter Property="Padding" Value="8,6"/>
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="#16415F"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ComboStyle" TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource InputFundoBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextoPadraoBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource InputBordaBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="22"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="1" Data="M0,0 L4,4 L8,0 Z" Fill="#94A3B8"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <ToggleButton.Background>
                                <Binding Path="Background" RelativeSource="{RelativeSource TemplatedParent}"/>
                            </ToggleButton.Background>
                            <ToggleButton.BorderBrush>
                                <Binding Path="BorderBrush" RelativeSource="{RelativeSource TemplatedParent}"/>
                            </ToggleButton.BorderBrush>
                        </ToggleButton>
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                            <Border Background="{StaticResource CardFundoBrush}" BorderBrush="{StaticResource InputBordaBrush}"
                                    BorderThickness="1" CornerRadius="7" MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="240">
                                <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                    <StackPanel IsItemsHost="True"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DatePickerStyle" TargetType="DatePicker">
        <Setter Property="Background" Value="{StaticResource InputFundoBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextoPadraoBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource InputBordaBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="6,4"/>
    </Style>

    <!-- Etiqueta (badge) -->
    <Style x:Key="EtiquetaStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource EtiquetaNeutraFundo}"/>
        <Setter Property="BorderBrush" Value="{StaticResource EtiquetaNeutraBorda}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="Padding" Value="9,4"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <Style x:Key="EtiquetaTextoStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Black"/>
    </Style>

    <!-- Cards -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardFundoBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardBordaBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="Effect" Value="{StaticResource SombraCard}"/>
    </Style>

    <!-- ContextMenu -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{StaticResource CardFundoBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource InputBordaBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6"/>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextoCelulaBrush}"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="fundo" Background="{TemplateBinding Background}" CornerRadius="6">
                        <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="fundo" Property="Background" Value="#16324A"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextoApagadoBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Background" Value="{StaticResource CardBordaBrush}"/>
        <Setter Property="Margin" Value="4,4"/>
    </Style>

    <!-- ScrollBar -->
    <Style x:Key="AssetlyScrollBarThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{StaticResource InputBordaBrush}" CornerRadius="999"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="{StaticResource CorFundoBase}"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource AssetlyScrollBarThumb}" Width="8"/>
                            </Track.Thumb>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Background="Transparent"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Background="Transparent"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- DataGrid -->
    <Style x:Key="TabelaStyle" TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource CardFundoBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextoCelulaBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardBordaBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="RowBackground" Value="{StaticResource CardFundoBrush}"/>
        <Setter Property="AlternatingRowBackground" Value="{StaticResource LinhaImparBrush}"/>
        <Setter Property="HorizontalGridLinesBrush" Value="Transparent"/>
        <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="CanUserReorderColumns" Value="False"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="RowHeight" Value="42"/>
        <Setter Property="GridLinesVisibility" Value="None"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
    </Style>

    <Style x:Key="CabecalhoColunaStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#111C2D"/>
        <Setter Property="Foreground" Value="{StaticResource TextoSuaveBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Black"/>
        <Setter Property="Padding" Value="10,10"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardBordaBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>

    <Style x:Key="LinhaTabelaStyle" TargetType="DataGridRow">
        <Setter Property="Background" Value="{StaticResource CardFundoBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource LinhaHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource LinhaSelecionadaBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="Black"/>
                <Setter Property="BorderBrush" Value="#67E8F9"/>
                <Setter Property="BorderThickness" Value="4,1,0,1"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CelulaTabelaStyle" TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Foreground" Value="{StaticResource TextoCelulaBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="Black"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ListaArquivosStyle" TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource CardFundoBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardBordaBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Background" Value="{StaticResource CardFundoBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextoCelulaBrush}"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="fundo" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="fundo" Property="Background" Value="{StaticResource LinhaHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="fundo" Property="Background" Value="{StaticResource LinhaSelecionadaBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Black"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
