<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Assetly.Dominio\Assetly.Dominio.csproj" />
    <ProjectReference Include="..\Assetly.Aplicacao\Assetly.Aplicacao.csproj" />
    <ProjectReference Include="..\Assetly.Infraestrutura\Assetly.Infraestrutura.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Só para o ícone da bandeja e as notificações do Windows (NotifyIcon); a interface continua toda em WPF. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Recursos\Imagens\assetly.ico</ApplicationIcon>
    <AssemblyName>Assetly</AssemblyName>
    <StartupObject>Assetly.Apresentacao.Programa</StartupObject>
    <!-- Sem número de versão: as releases são identificadas pela data (AAAA.MM.DD). O workflow release.yml
         passa -p:Version=AAAA.MM.DD; compilações locais ficam como "desenvolvimento". -->
    <Version>0.0.0</Version>
    <Company>Denis Carreto</Company>
    <Copyright>© Denis Carreto</Copyright>
    <Product>Assetly</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- Sem os usings globais do Windows Forms: Application, Button, MessageBox... são sempre os do WPF. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Recursos\Imagens\*.png" />
    <Resource Include="Recursos\Imagens\assetly.ico" />
  </ItemGroup>

  <!-- Publicação em arquivo único (perfil win-x64): entrega só o Assetly.exe, sem os .pdb das
       bibliotecas referenciadas. -->
  <Target Name="RemoverSimbolosDaPublicacao" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

</Project>
