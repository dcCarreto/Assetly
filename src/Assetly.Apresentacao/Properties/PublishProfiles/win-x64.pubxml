<?xml version="1.0" encoding="utf-8"?>
<!--
  Gera um único Assetly.exe autocontido para Windows 64 bits: roda em qualquer Windows 10/11 sem
  instalar o .NET. Uso (na raiz do repositório):

    dotnet publish src\Assetly.Apresentacao -p:PublishProfile=win-x64

  Saída: publicar\Assetly.exe
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\publicar\</PublishDir>
  </PropertyGroup>
</Project>
